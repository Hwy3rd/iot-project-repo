# Base URL of the REST API. Dev default "/api" goes through the Vite proxy.
# In production point it at the API origin, e.g. https://api.example.com
VITE_API_URL=/api

# Socket.IO origin. Empty = same origin as the page (dev proxy handles it).
VITE_SOCKET_URL=

# Backend the dev proxy forwards to (dev only).
VITE_DEV_API_TARGET=http://localhost:3000
