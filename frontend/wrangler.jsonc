// Cloudflare Workers static-assets deploy for the SPA. Build first
// (`pnpm build`), then `npx wrangler deploy` uploads ./dist. VITE_* values are
// baked in at build time — set them as *build* variables, not runtime vars.
{
  "name": "cold-warehouse-iot",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths so react-router handles deep links.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Required by `wrangler preview`, which Workers Builds runs for
  // non-production branches. Empty = previews inherit the settings above.
  "previews": {}
}
