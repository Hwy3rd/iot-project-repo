# Copy to .env.tunnel-mqtt (gitignored). Keep datastore/application secrets
# in the existing root .env. Do not also load the EMQX cloud overlay.
# The tunnel overlay fixes app/worker to this Docker-network MQTT URL.
MQTT_URL=mqtt://mosquitto:1883
MQTT_CA_FILE=
MQTT_USERNAME=iot-backend
MQTT_PASSWORD=<BACKEND_MOSQUITTO_PASSWORD>

# The primary physical node. Its permissions are tied to this ID and account,
# not to a client-supplied clientId. Credentials are provisioned in Mosquitto.
MQTT_DEVICE_USERNAME=esp32-cold-room-01
MQTT_DEVICE_PASSWORD=<DEVICE_MOSQUITTO_PASSWORD>
MQTT_DEVICE_ID=esp32-cold-room-01

# Informational: create this hostname route manually on the existing Tunnel.
# This variable alone does not create DNS or change firmware.
MQTT_PUBLIC_URL=wss://mqtt.hwyrd-dev.id.vn/mqtt
# CLOUDFLARE_TUNNEL_TOKEN stays in the existing root .env.
# Extra devices: copy mosquitto/tunnel-auth/devices.example to devices.txt.
