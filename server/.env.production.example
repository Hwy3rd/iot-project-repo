# Production environment template. Copy to server/.env on the deploy host
# and fill in every placeholder below — do not commit the filled-in file
# (server/.gitignore already excludes .env).
#
# Hostnames below (mysql/redis/mongo/minio) assume the app runs inside the
# docker-compose.production.yml network, where those are the container
# service names. If a datastore is hosted elsewhere (managed DB, etc.),
# replace the host/port with its real address instead.

PORT=3000

# MongoDB
MONGO_URI=mongodb://<user>:<CHANGE_ME_STRONG_PASSWORD>@mongo:27017/iot?authSource=admin

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=<CHANGE_ME>
MYSQL_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
MYSQL_DATABASE=iot_database

# Redis / BullMQ
REDIS_HOST=redis
REDIS_PORT=6379

# MQTT (device telemetry ingest, see mosquitto/mosquitto.conf). The bundled
# broker config allows anonymous connections — fine to get a real device
# talking to the system, but MQTT_USERNAME/MQTT_PASSWORD below (optional,
# read by libs/mqtt/mqtt.module.ts if set) plus locking down
# mosquitto.conf's `allow_anonymous` and adding a password_file is a
# follow-up hardening step before exposing the broker beyond a trusted
# network.
MQTT_URL=mqtt://mosquitto:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME_STRONG_SECRET>
MINIO_BUCKET=iot-uploads
# Public URL browsers use to load uploaded images — must be the real,
# internet-reachable domain/URL for MinIO (or the CDN in front of it), not
# localhost and not the docker-network MINIO_ENDPOINT above.
MINIO_PUBLIC_URL=https://<your-minio-or-cdn-domain>

# JWT / Cookie — generate distinct random secrets, e.g. `openssl rand -hex 32`.
# Never reuse the dev secrets from server/.env.
JWT_SECRET=<CHANGE_ME_RANDOM_SECRET>
JWT_EXPIRES_IN=15m
COOKIE_NAME=access_token
JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_SECRET>
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

# Web Push (VAPID) — worker only, used by AlertNotificationProcessor.
# Generate a fresh production keypair with `npx web-push generate-vapid-keys`
# — do not reuse the throwaway dev keypair from server/.env.
VAPID_PUBLIC_KEY=<CHANGE_ME>
VAPID_PRIVATE_KEY=<CHANGE_ME>
VAPID_SUBJECT=mailto:<admin-contact-email>

# WebSocket (RealtimeGateway) — comma-separated list of allowed origins for
# credentialed (cookie) connections. Must be the real frontend origin(s),
# exact match required — "*" is rejected because credentials: true is set.
WS_CORS_ORIGIN=https://<your-frontend-domain>

# Seed admin account (server/src/seeds/account.seed.ts, run via
# `pnpm run seed:admin` / init.sh). No-ops if an admin already exists.
# Set a strong password; rotate/remove it from this file after first use.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# Runtime
NODE_ENV=production
