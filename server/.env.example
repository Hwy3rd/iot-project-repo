# Template for server/.env — copy to server/.env and fill in the <...> values.
# Local dev env — for running the backend directly on the host
# (`pnpm start:dev`, `pnpm migration:run`, seeds, tests), with the datastores
# from the repo-root docker-compose.yml (`docker compose up -d redis mysql
# mongo minio mosquitto`). Hosts are `localhost` and credentials match that
# compose file's defaults. Production (containers) uses the repo-root .env
# instead — see the root .env.example and server/CLAUDE.md.

# App
PORT=3000
# Unset in local dev: nothing sits in front of the app, and trusting a proxy
# that isn't there lets any client spoof req.ip via X-Forwarded-For.
# TRUST_PROXY=
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://root:password@localhost:27017/iot?authSource=admin

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=iot_database

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT (device telemetry ingest — see mosquitto/mosquitto.conf, anonymous
# access allowed for local dev only)
MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# AI Forecasting Microservice (FastAPI + HistGradientBoosting)
AI_SERVICE_URL=http://localhost:8000

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=iot-uploads
# Browser-reachable base URL used to build the public image URLs stored in
# the database (MINIO_ENDPOINT is what the backend itself connects to).
MINIO_PUBLIC_URL=http://localhost:9000

# Auth — JWT / cookies
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=15m
COOKIE_NAME=access_token
JWT_REFRESH_SECRET=<openssl rand -hex 32, different from JWT_SECRET>
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

# Web Push (VAPID) — public key served by app (GET
# /notifications/vapid-public-key), keypair used by the worker's
# AlertNotificationProcessor. Dev-only keypair; generate with
# `npx web-push generate-vapid-keys`. Never reuse it in production.
VAPID_PUBLIC_KEY=<npx web-push generate-vapid-keys>
VAPID_PRIVATE_KEY=<npx web-push generate-vapid-keys>
VAPID_SUBJECT=mailto:dev@localhost

# Chatbot (Gemini Developer API / Google AI Studio). Get a key at
# aistudio.google.com/apikey. Leave blank if you're not testing the chatbot —
# LlmModule only warns at boot, chatbot LLM calls just fail until this is set.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=1024
# Total attempts incl. the original request, only on 429/5xx (see
# LLM_RETRY_STATUS_CODES) — kept modest since retries burn the same
# free-tier quota as fresh requests.
LLM_RETRY_ATTEMPTS=3
# Per-user caps on POST /chatbot/conversations/:id/messages (see
# ChatbotRateLimitGuard) — the per-day cap is the real one given Google AI
# Studio's free-tier quota.
CHATBOT_RATE_LIMIT_PER_MINUTE=10
CHATBOT_RATE_LIMIT_PER_DAY=200
# search_docs tool: defaults to ../docs relative to the working directory,
# i.e. the repo's docs/ when run from server/.
# CHATBOT_DOCS_DIR=

# CORS — comma-separated browser origins allowed to call the API with cookies,
# for both REST and WebSocket (socket.io). Exact origins only, not "*"
# (credentials: true is set, which browsers reject alongside a wildcard).
CORS_ORIGINS=http://localhost:5173

# Seed accounts (server/src/seeds/account.seed.ts, `pnpm run seed:admin`).
# Admin + one manager, technician and staff account, all with
# SEED_ADMIN_PASSWORD. The admin step no-ops if an admin already exists; each
# other account is skipped if its username is taken, and has no warehouse.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<local admin password>
SEED_MANAGER_USERNAME=manager
SEED_TECHNICIAN_USERNAME=technician
SEED_STAFF_USERNAME=staff
