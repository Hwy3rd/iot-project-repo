# Production environment template — the single env file for
# docker-compose.production.yml. Copy to .env (repo root, next to the compose
# file) on the deploy host and fill in every placeholder below. Do not commit
# the filled-in file (.gitignore already excludes .env); `chmod 600 .env`.
#
# Compose uses this file two ways:
#   1. `env_file:` for the app/worker containers — they see every variable.
#   2. `${VAR}` substitution inside the compose file — mysql/mongo/minio/
#      cloudflared only get the specific variables passed to them there.
# Because of (2), a literal `$` in a value is treated as a variable reference:
# avoid `$` in secrets (e.g. use `openssl rand -hex 32`) or wrap the value in
# single quotes.
#
# Hostnames below (mysql/redis/mongo/minio/mosquitto) assume the app runs
# inside the docker-compose network, where those are the container service
# names. If a datastore is hosted elsewhere (managed DB, etc.), replace the
# host/port with its real address instead. For running the backend directly on
# the host (pnpm start:dev), use server/.env instead — see server/CLAUDE.md.

PORT=3000

# Set only when the app sits behind a reverse proxy (Cloudflare Tunnel, nginx,
# a load balancer…) so req.ip — recorded in audit logs — is the real client,
# not the proxy. "1" = trust one hop (cloudflared); or a subnet list, e.g.
# "loopback, 172.16.0.0/12". Leave unset when clients connect directly:
# trusting a proxy that isn't there lets any client spoof its IP via
# X-Forwarded-For.
# TRUST_PROXY=1

# MongoDB — MONGO_ROOT_* create the root user on the mongo container's first
# start (empty volume only); MONGO_URI is what app/worker connect with, so its
# credentials must match them.
MONGO_ROOT_USERNAME=<CHANGE_ME>
MONGO_ROOT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
MONGO_URI=mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@mongo:27017/iot?authSource=admin

# MySQL — MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE are used both by app/worker
# to connect and by the mysql container to create that user/database (empty
# volume only — changing them later does not alter an existing database).
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
MYSQL_USER=<CHANGE_ME>
MYSQL_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
MYSQL_DATABASE=iot_database

# Redis / BullMQ — REDIS_PASSWORD is also the redis container's
# `requirepass`; app/worker (ioredis + BullMQ) log in with it.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_RANDOM_SECRET>

# MQTT (device telemetry ingest). The broker refuses anonymous clients: its
# password file + ACL are generated from these four variables at container
# start (mosquitto/entrypoint.sh). MQTT_USERNAME/MQTT_PASSWORD is the
# backend's account (may only read telemetry); MQTT_DEVICE_* is the one
# shared account flashed into every device's firmware (may only publish to
# devices/<unique_id>/telemetry). Changing any of them takes effect on the
# next `./run.sh restart mosquitto` (plus app for the backend account).
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=server
MQTT_PASSWORD=<CHANGE_ME_RANDOM_SECRET>
MQTT_DEVICE_USERNAME=device
MQTT_DEVICE_PASSWORD=<CHANGE_ME_RANDOM_SECRET>

# MinIO (S3-compatible object storage) — also the minio container's root
# credentials (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD).
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME_STRONG_SECRET>
MINIO_BUCKET=iot-uploads
# Public URL browsers use to load uploaded images — must be the real,
# internet-reachable domain/URL for MinIO (or the CDN in front of it), not
# localhost and not the docker-network MINIO_ENDPOINT above.
MINIO_PUBLIC_URL=https://<your-minio-or-cdn-domain>

# JWT / Cookie — generate distinct random secrets, e.g. `openssl rand -hex 32`.
# Never reuse the dev secrets from server/.env.
JWT_SECRET=<CHANGE_ME_RANDOM_SECRET>
JWT_EXPIRES_IN=15m
COOKIE_NAME=access_token
JWT_REFRESH_SECRET=<CHANGE_ME_RANDOM_SECRET>
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refresh_token

# Failed-login limits on POST /auth/login (LoginRateLimiterService, see
# docs/API_DESIGN.md §2). Failures are counted per username+IP, per IP and
# per username over LOGIN_FAILED_WINDOW_MINUTES; a count reaching its
# LOGIN_MAX_FAILED_* cap blocks logins through it (429). The username+IP and
# IP blocks escalate through LOGIN_LOCKOUT_STEPS_MINUTES (1st lockout 1 min,
# 2nd 5, 3rd 15, then 60 every time; comma-separated, non-decreasing);
# lockouts are forgotten after LOGIN_LOCKOUT_RESET_HOURS without a new one. The
# per-username block stays at LOGIN_ACCOUNT_LOCKOUT_MINUTES (escalating it
# would let anyone lock a real user out). A correct password doesn't count;
# an admin's "unlock" lifts an account's blocks early. All optional — the
# values below are the defaults; the app refuses to start if one isn't a
# positive integer.
LOGIN_MAX_FAILED_PER_ACCOUNT_IP=5
LOGIN_MAX_FAILED_PER_IP=30
LOGIN_MAX_FAILED_PER_ACCOUNT=50
LOGIN_FAILED_WINDOW_MINUTES=15
LOGIN_LOCKOUT_STEPS_MINUTES=1,5,15,60
LOGIN_LOCKOUT_RESET_HOURS=24
LOGIN_ACCOUNT_LOCKOUT_MINUTES=15

# Web Push (VAPID) — public key served by app, keypair used by the worker's
# AlertNotificationProcessor. Generate a fresh production keypair with
# `npx web-push generate-vapid-keys` — do not reuse the throwaway dev keypair
# from server/.env.
VAPID_PUBLIC_KEY=<CHANGE_ME>
VAPID_PRIVATE_KEY=<CHANGE_ME>
VAPID_SUBJECT=mailto:<admin-contact-email>

# LLM (chatbot) — Gemini Developer API (Google AI Studio).
GEMINI_API_KEY=<CHANGE_ME>
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=1024
LLM_RETRY_ATTEMPTS=3
LLM_REQUEST_TIMEOUT_MS=30000
# Per-user caps on POST /chatbot/conversations/:id/messages (see
# ChatbotRateLimitGuard) — the per-day cap is the real one given Google AI
# Studio's free-tier quota.
CHATBOT_RATE_LIMIT_PER_MINUTE=10
CHATBOT_RATE_LIMIT_PER_DAY=200
# search_docs tool (see chatbot-docs-search.ts) reads whitelisted .md files
# from this directory
CHATBOT_DOCS_DIR=/app/docs

# CORS — comma-separated list of browser origins allowed to call the API with
# cookies, for both REST and WebSocket (socket.io). Must be the real frontend
# origin(s), exact match required — "*" is rejected because credentials: true
# is set.
CORS_ORIGINS=https://<your-frontend-domain>

# Seed accounts (server/src/seeds/account.seed.ts, run via
# `pnpm run seed:admin` / init.sh): admin + one manager, technician and
# staff account, all with SEED_ADMIN_PASSWORD. The admin step no-ops if an
# admin already exists; each other account is skipped if its username is
# taken, and starts with no warehouse (assign them from the warehouse's
# detail dialog). *_EMAIL and *_FULL_NAME are optional. Set a strong
# password; rotate/remove it from this file after first use.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
SEED_MANAGER_USERNAME=manager
SEED_TECHNICIAN_USERNAME=technician
SEED_STAFF_USERNAME=staff

# Cloudflare Tunnel token (cloudflared container only): Cloudflare dashboard
# -> Zero Trust -> Networks -> Tunnels -> create tunnel (Docker) -> copy the
# value after `--token`. Leave empty to run without the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=<CHANGE_ME>

# Runtime
NODE_ENV=production
