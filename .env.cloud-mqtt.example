# Private cloud MQTT configuration. Copy to .env.cloud-mqtt (gitignored).
# Docker: use docker-compose.cloud-mqtt.yml and pass this as --env-file.
# Host backend: relative CA path is resolved from the server/ directory.
MQTT_URL=mqtts://n0c006e0.ala.asia-southeast1.emqxsl.com:8883
MQTT_USERNAME=iot-backend
MQTT_PASSWORD=<BACKEND_MQTT_PASSWORD>
MQTT_CA_FILE=../certs/mqtt/emqxsl-ca.crt
# Used by the connectivity check; each physical ESP32 gets its own account.
MQTT_DEVICE_USERNAME=esp32-cold-room-01
MQTT_DEVICE_PASSWORD=<DEVICE_MQTT_PASSWORD>
MQTT_DEVICE_ID=esp32-cold-room-01
